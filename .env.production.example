# CareOps Production Environment Variables Template
# Copy this to .env and fill in the values

# =============================================
# REQUIRED - SECURITY SECRETS (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# =============================================
SECRET_KEY=your-secret-key-here-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars

# =============================================
# APPLICATION
# =============================================
APP_NAME=CareOps API
APP_ENV=production
DEBUG=false

# =============================================
# DATABASE (PostgreSQL - Supabase or Railway)
# =============================================
# Example Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
# Example Railway: postgresql://postgres:password@railway-host:5432/careops
DATABASE_URL=postgresql://postgres:password@localhost:5432/careops

# =============================================
# JWT CONFIGURATION
# =============================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# =============================================
# CORS (Production URLs)
# =============================================
# Add your production frontend URL here
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.com

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_GENERAL=100/minute

# =============================================
# OPTIONAL - THIRD-PARTY SERVICES
# =============================================

# Groq AI (for AI features) - Get from https://console.groq.com
GROQ_API_KEY=

# SendGrid (Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=careops-files
AWS_REGION=us-east-1
