# =============================================================
# CareOps Backend - Environment Variables
# =============================================================
# Copy this file to .env and fill in the values
# cp .env.example .env
# =============================================================

# ---- REQUIRED ----

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careops

# Security Secrets (CHANGE THESE IN PRODUCTION!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production-immediately
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

# ---- APPLICATION ----
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ---- OPTIONAL: AI ----
GROQ_API_KEY=

# ---- OPTIONAL: Email (SendGrid) ----
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@careops.io

# ---- OPTIONAL: Email (Gmail API) ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
GMAIL_EMAIL=

# ---- OPTIONAL: WhatsApp Business API ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=careops_whatsapp_verify

# ---- OPTIONAL: Slack Integration ----
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
