# =============================================================
# CareOps Docker Compose - Environment Variables
# =============================================================
# Copy this file to .env to override docker-compose defaults
# cp .env.example .env
# =============================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careops

# Backend Secrets (CHANGE IN PRODUCTION!)
SECRET_KEY=dev-secret-key-change-in-production-immediately
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production

# App Mode
APP_ENV=development
DEBUG=true

# Optional: AI
GROQ_API_KEY=

# Optional: Email
SENDGRID_API_KEY=

# Optional: WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=careops_whatsapp_verify

# Optional: Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
